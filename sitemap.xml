---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- comment %} Every page that isn't marked noindex, then every blog post {% endcomment %}
{%- assign pages = site.html_pages | where_exp: "p", "p.noindex != true" %}
{%- for p in pages %}
  <url><loc>{{ site.url }}{{ p.url | replace: "index.html", "" }}</loc></url>
{%- endfor %}
{%- for post in site.posts %}
  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod></url>
{%- endfor %}
</urlset>
